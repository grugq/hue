#compdef hue
# zsh completion for hue

_hue() {
  local curcontext=$curcontext state state_descr line ret=1
  typeset -A opt_args

  _arguments -C \
    '(-q --quiet)'{-q,--quiet}'[suppress non-fatal warnings]' \
    '--no-user[ignore ~/.config/hue/themes]' \
    '--themes-dir=[override search path (colon-separated)]:directory:_files -/' \
    '(- *)'{-h,--help}'[print usage and exit]' \
    '(- *)'{-V,--version}'[print version and exit]' \
    '1:command:_hue_first' \
    '*::arg:->subcmd' && ret=0

  case $state in
    subcmd)
      case $words[1] in
        list)
          _arguments \
            '(-l --long)'{-l,--long}'[show variant and description]' && ret=0
          ;;
        path|generate)
          _arguments '1:theme:_hue_themes' && ret=0
          ;;
        check)
          _arguments \
            '--all[validate every theme on the search path]' \
            '1:theme:_hue_themes' && ret=0
          ;;
        current|help|version)
          ret=0
          ;;
      esac
      ;;
  esac

  return ret
}

_hue_first() {
  local -a subcommands themes
  subcommands=(
    'generate:print theme as eval-able zsh code'
    'list:list available themes'
    'path:print resolved path for a theme'
    'current:print most recently applied theme'
    'check:validate theme(s)'
    'help:print usage'
    'version:print version'
  )
  themes=( ${(f)"$(_call_program themes hue list 2>/dev/null)"} )

  _describe -t subcommands 'subcommand' subcommands
  _describe -t themes 'theme' themes
}

_hue_themes() {
  local -a themes
  themes=( ${(f)"$(_call_program themes hue list 2>/dev/null)"} )
  _describe -t themes 'theme' themes
}

_hue "$@"
